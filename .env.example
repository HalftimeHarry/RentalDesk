# Public URL of your PocketBase instance (used by the SvelteKit server and the browser for file links)
PUBLIC_POCKETBASE_URL=https://pocketbase-railway-production-f446.up.railway.app

# PocketBase superuser credentials — only used by scripts/setup-pocketbase.mjs
PRIVATE_POCKETBASE_SUPERUSER_EMAIL=email@gmail.com
PRIVATE_POCKETBASE_SUPERUSER_PASSWORD=your_superuser_password_here

# Optional: create the first Owner account during setup
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=your_owner_password_here
OWNER_NAME=Owner

RESEND_API_KEY=your_key_here
EMAIL_FROM=Rental Desk <onboarding@resend.dev>
EMAIL_TEST_TO=your-email@example.com

# Public base URL of the app for user-facing links (e.g. admin invitations).
# REQUIRED for local development/tests (use the forwarded dev URL) — invitations
# fail with a configuration error if it is missing or invalid. Only an explicitly
# identified production environment (APP_ENV=production or Netlify production
# context) may leave it unset and fall back to https://bstreet102.netlify.app.
PUBLIC_APP_URL=

# Outbound email is DISABLED unless exactly "true". Even when enabled, only
# addresses on the server-side test allowlist (src/lib/server/mail.ts) can receive
# mail — all other To/CC/BCC are blocked before any network call.
PRIVATE_EMAIL_ENABLED=false